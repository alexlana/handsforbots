{
  "name": "handsforbots-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter '@handsforbots/*' --filter '!@handsforbots/example-*' build",
    "test": "vitest run && pnpm --filter @handsforbots/semantic-event-observability test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter '@handsforbots/*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
