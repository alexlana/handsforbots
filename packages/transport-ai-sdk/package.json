{
  "name": "@handsforbots/transport-ai-sdk",
  "version": "2.0.0-alpha.0",
  "description": "Vercel AI SDK (UI message stream) transport for Hands for Bots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/testkit": "workspace:^",
    "ai": "^7.0.0"
  }
}
