{
  "name": "@handsforbots/testkit",
  "version": "2.0.0-alpha.0",
  "description": "Test helpers and a transport conformance suite for Hands for Bots plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "vitest": ">=3"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^"
  }
}
