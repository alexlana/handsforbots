{
  "name": "@handsforbots/react",
  "version": "2.0.0-alpha.0",
  "description": "React bindings for Hands for Bots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
