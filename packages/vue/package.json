{
  "name": "@handsforbots/vue",
  "version": "2.0.0-alpha.0",
  "description": "Vue bindings for Hands for Bots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^",
    "jsdom": "^27.0.0",
    "vue": "^3.5.0"
  }
}
