{
  "name": "@handsforbots/transport-http",
  "version": "2.0.0-alpha.0",
  "description": "Generic HTTP turn transport for Hands for Bots (sessions, SSE, tool calls) with UniversalLLM and OpenAI-compatible presets.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^"
  }
}
