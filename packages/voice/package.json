{
  "name": "@handsforbots/voice",
  "version": "2.0.0-alpha.0",
  "description": "Voice for Hands for Bots: pluggable speech-to-text and text-to-speech (browser or cloud), push-to-talk, hands-free and barge-in.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "jsdom": "^27.0.0"
  }
}
