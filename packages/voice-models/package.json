{
  "name": "@handsforbots/voice-models",
  "version": "2.0.0-alpha.0",
  "description": "Neural text-to-speech in the browser for @handsforbots/voice: Piper, Kokoro and transformers.js pipelines, models from Hugging Face, any URL or a local file, downloaded with progress and cached.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^"
  }
}
