{
  "name": "@handsforbots/assistant-ui",
  "version": "2.0.0-alpha.0",
  "description": "assistant-ui runtime for Hands for Bots: use assistant-ui components as the conversation surface over any H4B transport.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.15",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.23",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
